{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "types": ["@playwright/test"],
    "allowJs": false,
    "outDir": "dist"
  },
  "include": ["playwright.config.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
